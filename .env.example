# === Environment ===
APP_ENV=local
APP_DEBUG=true

# === Database ===
DB_HOST=host.docker.internal
DB_PORT=3307
DB_USER=root
DB_PASSWORD=

AUTH_DB_NAME=authdb
GROUP_DB_NAME=groupdb
TIME_DB_NAME=timedb

# === Service Metadata ===
SERVICE_NAME=gw-service
REQUEST_TIMEOUT=10

AUTH_SERVICE_URL=http://auth-service:8080
GROUP_SERVICE_URL=http://group-service:8080
TIME_SERVICE_URL=http://time-service:8080

# === CORS ===
ENABLE_CORS=true
CORS_ALLOW_ORIGIN_PATTERN=^https?://(localhost|127\.0\.0\.1|([a-z0-9-]+\.)?localhost)(:[0-9]+)?$
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept